{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/event-reminders",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "src/app/api/recordings/upload/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    }
  }
}
